{
  "name": "@zakir161208/playwright-shared-library",
  "version": "1.0.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/resolve-path-aliases.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [],
  "author": "zakir161208",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakir161208/playwright-shared-library.git"
  },
  "license": "ISC",
  "description": "Shared Playwright utilities for QA automation projects.",
  "peerDependencies": {
    "@playwright/test": "^1.51.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
